{
  "openapi": "3.0.3",
  "info": {
    "title": "OnDemand Spatial Military Installations (OSM)",
    "version": "1.0.0",
    "description": "Mapped military installations, airfields, naval stations, training ranges, barracks, and restricted military landuse from OpenStreetMap inside a bounding box (up to 10 degrees wide). Uses the cached Overpass QL installation proxy to retrieve feature tags, names, geometries, and center coordinates. Keyless open data.",
    "x-ondemand-spatial": {
      "pluginId": "military_installations",
      "category": "Research",
      "conversationStarters": [
        "Find military installations and airfields near San Diego (box 32.5,-117.3 to 33.0,-116.8)",
        "Search for mapped naval bases and defense facilities around Norfolk, VA (box 36.8,-76.4 to 37.1,-76.0)",
        "Are there military ranges or airfields near Las Vegas (box 36.0,-115.5 to 36.7,-114.8)?",
        "List defense sites and military areas around Oahu, Hawaii"
      ],
      "auth": "none — same-origin proxy; upstream credentials stay server-side",
      "generatedBy": "scripts/generate-tool-openapi.mjs"
    }
  },
  "servers": [
    {
      "url": "https://ondemand-eand-spatial-opal.vercel.app",
      "description": "OnDemand Spatial deployment (preview or production)"
    }
  ],
  "paths": {
    "/api/tools/military_installations_in_bbox": {
      "get": {
        "operationId": "military_installations_in_bbox",
        "summary": "OpenStreetMap mapped military bases, airfields, and installations in a bounding box",
        "description": "Queries OpenStreetMap for mapped military installations (airfields, naval bases, barracks, ranges, and landuse=military) inside a bounding box (south, west, north, east). Bounding box must not cross the antimeridian and must span at most 10 degrees in latitude and longitude. Returns feature tags, geometry type, center coordinates, and name.",
        "parameters": [
          {
            "name": "south",
            "in": "query",
            "required": true,
            "description": "Bounding-box south latitude in decimal degrees.",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "west",
            "in": "query",
            "required": true,
            "description": "Bounding-box west longitude in decimal degrees.",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "north",
            "in": "query",
            "required": true,
            "description": "Bounding-box north latitude in decimal degrees.",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "east",
            "in": "query",
            "required": true,
            "description": "Bounding-box east longitude in decimal degrees.",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of installations to return (1 to 200). Default 50.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tool result envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResult"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (unknown/missing/invalid parameter)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure with a structured reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "503": {
            "description": "Provider unavailable (missing key / no data) with a structured reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Provider": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "stale",
              "degraded",
              "unavailable"
            ]
          },
          "source": {
            "type": "string"
          },
          "fetchedAt": {
            "type": "string",
            "nullable": true
          },
          "ageSec": {
            "type": "integer",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "count": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ToolResult": {
        "type": "object",
        "required": [
          "ok",
          "tool",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "tool": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": true
          },
          "generatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ToolError": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "tool": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "param": {
                "type": "string"
              }
            }
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          }
        }
      }
    }
  }
}
