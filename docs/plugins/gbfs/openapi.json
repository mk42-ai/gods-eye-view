{
  "openapi": "3.0.3",
  "info": {
    "title": "OnDemand Spatial Bike Share Status (GBFS)",
    "version": "1.0.0",
    "description": "Real-time bikeshare station locations and bike/dock availability from official GBFS (General Bikeshare Feed Specification) feeds across North America: Citi Bike NYC, Divvy Chicago, Capital Bikeshare DC, Bay Wheels SF, Bluebikes Boston, Indego Philadelphia, BIKETOWN Portland, Metro Bike LA, CapMetro Bikeshare Austin, and dozens of BCycle systems. Returns nearest stations with available mechanical bikes, ebikes, empty docks, and renting status.",
    "x-ondemand-spatial": {
      "pluginId": "gbfs",
      "category": "Research",
      "conversationStarters": [
        "Are there available bikes near Times Square NYC (lat 40.758, lon -73.985)?",
        "Find bike share docks near the Texas State Capitol in Austin (lat 30.274, lon -97.740)",
        "Check bike availability near Millennium Park Chicago (lat 41.882, lon -87.624)",
        "List bike stations within 2 km of Downtown Boston (lat 42.360, lon -71.058)"
      ],
      "auth": "none — same-origin proxy; upstream credentials stay server-side",
      "generatedBy": "scripts/generate-tool-openapi.mjs"
    }
  },
  "servers": [
    {
      "url": "https://ondemand-eand-spatial-opal.vercel.app",
      "description": "OnDemand Spatial deployment (preview or production)"
    }
  ],
  "paths": {
    "/api/tools/bike_share_status_near": {
      "get": {
        "operationId": "bike_share_status_near",
        "summary": "Live bike-share stations and availability near coordinates (GBFS)",
        "description": "Discovers the nearest registered GBFS bike-share network for a lat/lon coordinate, fetches its station metadata and real-time status (available bikes, e-bikes, docks), and returns stations within radius_km sorted by distance. An explicit system_id (e.g. \"nyc-citibike\", \"chicago-divvy\", \"sf-bay-wheels\") can be specified to select a specific network.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "description": "Target latitude in decimal degrees (WGS84).",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "description": "Target longitude in decimal degrees (WGS84).",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "description": "Search radius in kilometres around lat/lon (0.5 to 50). Default 10 km.",
            "schema": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 50,
              "default": 10
            }
          },
          {
            "name": "system_id",
            "in": "query",
            "required": false,
            "description": "Optional explicit GBFS system identifier (e.g. \"nyc-citibike\", \"sf-bay-wheels\").",
            "schema": {
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of stations to return (1 to 100). Default 30.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tool result envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResult"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (unknown/missing/invalid parameter)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure with a structured reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "503": {
            "description": "Provider unavailable (missing key / no data) with a structured reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Provider": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "stale",
              "degraded",
              "unavailable"
            ]
          },
          "source": {
            "type": "string"
          },
          "fetchedAt": {
            "type": "string",
            "nullable": true
          },
          "ageSec": {
            "type": "integer",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "count": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ToolResult": {
        "type": "object",
        "required": [
          "ok",
          "tool",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "tool": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": true
          },
          "generatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ToolError": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "tool": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "param": {
                "type": "string"
              }
            }
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          }
        }
      }
    }
  }
}
