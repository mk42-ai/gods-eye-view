{
  "openapi": "3.0.3",
  "info": {
    "title": "OnDemand Spatial Terrain Elevation (Re:Earth)",
    "version": "1.0.0",
    "description": "Batched ellipsoidal terrain elevation (height in metres above the WGS84 ellipsoid) at geographic coordinates for single points or batched lists (up to 50 points per query). Powered by Re:Earth global terrain with 30-day disk caching and sequential chunking. Keyless open data.",
    "x-ondemand-spatial": {
      "pluginId": "terrain",
      "category": "Research",
      "conversationStarters": [
        "What is the terrain height at Mount Everest summit (lat 27.9881, lon 86.9250)?",
        "Get elevation for Death Valley Badwater Basin (lat 36.2503, lon -116.8258)",
        "Look up terrain height at central Zurich (lat 47.3769, lon 8.5417)",
        "Query elevation along a transect between Denver and Aspen"
      ],
      "auth": "none — same-origin proxy; upstream credentials stay server-side",
      "generatedBy": "scripts/generate-tool-openapi.mjs"
    }
  },
  "servers": [
    {
      "url": "https://ondemand-eand-spatial-opal.vercel.app",
      "description": "OnDemand Spatial deployment (preview or production)"
    }
  ],
  "paths": {
    "/api/tools/terrain_height_at": {
      "get": {
        "operationId": "terrain_height_at",
        "summary": "Ellipsoidal terrain height in metres at geographic coordinates (up to 50 points)",
        "description": "Looks up ellipsoidal terrain height in metres (WGS84) for a point (lat, lon) or a batched list of coordinates (up to 50 points formatted as \"lon,lat;lon,lat;...\"). Powered by Re:Earth heights API with long-term caching. Keyless.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of single point in decimal degrees. Required if `points` is omitted.",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Longitude of single point in decimal degrees. Required if `points` is omitted.",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "points",
            "in": "query",
            "required": false,
            "description": "Batched coordinate string in \"lon,lat;lon,lat;...\" format (up to 50 points). Takes precedence over lat/lon.",
            "schema": {
              "type": "string",
              "maxLength": 2000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tool result envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResult"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (unknown/missing/invalid parameter)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure with a structured reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "503": {
            "description": "Provider unavailable (missing key / no data) with a structured reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Provider": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "stale",
              "degraded",
              "unavailable"
            ]
          },
          "source": {
            "type": "string"
          },
          "fetchedAt": {
            "type": "string",
            "nullable": true
          },
          "ageSec": {
            "type": "integer",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "count": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ToolResult": {
        "type": "object",
        "required": [
          "ok",
          "tool",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "tool": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": true
          },
          "generatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ToolError": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "tool": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "param": {
                "type": "string"
              }
            }
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          }
        }
      }
    }
  }
}
