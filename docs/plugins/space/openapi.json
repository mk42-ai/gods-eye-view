{
  "openapi": "3.0.3",
  "info": {
    "title": "OnDemand Spatial Space Launches (Launch Library 2)",
    "version": "1.0.0",
    "description": "Recent and upcoming orbital rocket launches worldwide from The Space Devs Launch Library 2 (LL2). Tracks launch missions, launch service providers (SpaceX, NASA, ISRO, Roscosmos, Rocket Lab, ESA, Arianespace), rocket configuration, launch pad location coordinates, mission objectives, and launch status (success, failure, in-flight, upcoming). 15-minute server cache. Keyless open data.",
    "x-ondemand-spatial": {
      "pluginId": "space",
      "category": "Research",
      "conversationStarters": [
        "What were the most recent orbital rocket launches worldwide?",
        "List upcoming space launches scheduled this month",
        "Are there any recent Falcon 9 or SpaceX launches recorded?",
        "Show rocket launches that took place from Cape Canaveral / Kennedy Space Center"
      ],
      "auth": "none — same-origin proxy; upstream credentials stay server-side",
      "generatedBy": "scripts/generate-tool-openapi.mjs"
    }
  },
  "servers": [
    {
      "url": "https://ondemand-eand-spatial-opal.vercel.app",
      "description": "OnDemand Spatial deployment (preview or production)"
    }
  ],
  "paths": {
    "/api/tools/rocket_launches_recent": {
      "get": {
        "operationId": "rocket_launches_recent",
        "summary": "Recent and upcoming orbital rocket launches worldwide (Launch Library 2)",
        "description": "Queries orbital rocket launches worldwide from Launch Library 2 (LL2). Filterable by outcome status (all, success, failure, upcoming). Returns launch mission name, launch provider / agency, rocket configuration, launch pad coordinates, scheduled launch time (UTC), mission description, and flight outcome.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter launches by status: \"all\", \"success\", \"failure\", or \"upcoming\". Default all.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "success",
                "failure",
                "upcoming"
              ],
              "default": "all"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of launches to return (1 to 50). Default 20.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tool result envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResult"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (unknown/missing/invalid parameter)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure with a structured reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "503": {
            "description": "Provider unavailable (missing key / no data) with a structured reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Provider": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "stale",
              "degraded",
              "unavailable"
            ]
          },
          "source": {
            "type": "string"
          },
          "fetchedAt": {
            "type": "string",
            "nullable": true
          },
          "ageSec": {
            "type": "integer",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "count": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ToolResult": {
        "type": "object",
        "required": [
          "ok",
          "tool",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "tool": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": true
          },
          "generatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ToolError": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "tool": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "param": {
                "type": "string"
              }
            }
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          }
        }
      }
    }
  }
}
