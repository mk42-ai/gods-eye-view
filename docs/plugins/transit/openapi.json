{
  "openapi": "3.0.3",
  "info": {
    "title": "OnDemand Spatial Transit Vehicles (GTFS-RT)",
    "version": "1.0.0",
    "description": "Live public transit vehicle positions (buses, trains, light rail, ferries) from official GTFS-Realtime feeds across North America, Europe, and Australia: MBTA (Boston), CapMetro (Austin), Metro Transit (Minneapolis-St. Paul), HSL (Helsinki), OVapi (Netherlands national), Entur (Norway national), and Translink (SE Queensland). Supports spatial bounding-box filtering, proximity search, or direct feed selection with vehicle IDs, route labels, bearings, and freshness.",
    "x-ondemand-spatial": {
      "pluginId": "transit",
      "category": "Research",
      "conversationStarters": [
        "How many CapMetro transit vehicles are operating in Austin right now?",
        "Show live MBTA transit vehicles in Boston inside bbox 42.25,-71.20 to 42.42,-70.95",
        "List active HSL trams and buses currently running in Helsinki",
        "Which public transit vehicles are active in the Minneapolis-St. Paul area?"
      ],
      "auth": "none — same-origin proxy; upstream credentials stay server-side",
      "generatedBy": "scripts/generate-tool-openapi.mjs"
    }
  },
  "servers": [
    {
      "url": "https://ondemand-eand-spatial-opal.vercel.app",
      "description": "OnDemand Spatial deployment (preview or production)"
    }
  ],
  "paths": {
    "/api/tools/transit_vehicles_in_bbox": {
      "get": {
        "operationId": "transit_vehicles_in_bbox",
        "summary": "Live transit vehicle positions inside a bounding box or near a point (GTFS-RT)",
        "description": "Queries real-time transit vehicle positions (buses, trains, rail, ferries) from open GTFS-RT feeds inside a bounding box (lamin, lomin, lamax, lomax) or within radius_km of lat/lon. If `feed` is omitted, the feed closest to the coordinates is automatically selected. Available feeds: mbta, capmetro-austin, metrotransit-msp, hsl-helsinki, ovapi-nl, entur-norway, translink-seq.",
        "parameters": [
          {
            "name": "feed",
            "in": "query",
            "required": false,
            "description": "GTFS-RT feed ID to query (mbta, capmetro-austin, metrotransit-msp, hsl-helsinki, ovapi-nl, entur-norway, translink-seq). Optional.",
            "schema": {
              "type": "string",
              "enum": [
                "mbta",
                "capmetro-austin",
                "metrotransit-msp",
                "hsl-helsinki",
                "ovapi-nl",
                "entur-norway",
                "translink-seq"
              ]
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Centre latitude in decimal degrees. Used for proximity filtering or feed auto-selection.",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Centre longitude in decimal degrees. Used for proximity filtering or feed auto-selection.",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "description": "Radius around lat/lon in kilometres (when bbox is not supplied). Default 50 km.",
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 300,
              "default": 50
            }
          },
          {
            "name": "lamin",
            "in": "query",
            "required": false,
            "description": "Bounding-box south latitude. Requires lomin, lamax, lomax.",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lomin",
            "in": "query",
            "required": false,
            "description": "Bounding-box west longitude. Requires lamin, lamax, lomax.",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "lamax",
            "in": "query",
            "required": false,
            "description": "Bounding-box north latitude. Requires lamin, lomin, lomax.",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lomax",
            "in": "query",
            "required": false,
            "description": "Bounding-box east longitude. Requires lamin, lomin, lamax.",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of transit vehicles to return (1 to 500). Default 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tool result envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResult"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (unknown/missing/invalid parameter)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure with a structured reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "503": {
            "description": "Provider unavailable (missing key / no data) with a structured reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Provider": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "stale",
              "degraded",
              "unavailable"
            ]
          },
          "source": {
            "type": "string"
          },
          "fetchedAt": {
            "type": "string",
            "nullable": true
          },
          "ageSec": {
            "type": "integer",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "count": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ToolResult": {
        "type": "object",
        "required": [
          "ok",
          "tool",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "tool": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": true
          },
          "generatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ToolError": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "tool": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "param": {
                "type": "string"
              }
            }
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          }
        }
      }
    }
  }
}
