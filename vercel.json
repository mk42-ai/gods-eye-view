{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=1 npm ci",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,data/**,src/data/local_data/cctv_ground_heights/**}"
    },
    "api/ondemand/*.js": {
      "maxDuration": 60
    },
    "api/footage/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/footage",
      "destination": "/api/footage/index?__fp=index"
    },
    {
      "source": "/footage/:__fp*",
      "destination": "/api/footage/index?__fp=:__fp*"
    },
    {
      "source": "/api/footage/:__fp*",
      "destination": "/api/footage/index?__fp=:__fp*"
    },
    {
      "source": "/api/:__gev_api_path*",
      "destination": "/api/route"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/cesium/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
